# Frontend build-time configuration.
# Copy to .env.local for local development; set the same variable in the
# deployment environment (Railway) so it is present when the frontend is built.
# Vite inlines VITE_* variables into the bundle at build time — a build without
# this value renders no CAPTCHA widget and the contact form cannot be submitted.

# Cloudflare Turnstile site key. Public by design and safe to expose in the
# browser. The matching secret is server-side only — see server/.env.
VITE_TURNSTILE_SITE_KEY=
